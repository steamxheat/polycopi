[Unit]
Description=Polymarket copy-trading simulator
After=network-online.target
Wants=network-online.target

[Service]
User=USER
WorkingDirectory=/home/USER/polycopy-sim
ExecStart=/usr/bin/python3 -u /home/USER/polycopy-sim/simbot.py run
Restart=always
RestartSec=10
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
